# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholders with real values.
# NEVER commit .env to version control!
#
# Usage:
#   cp .env.example .env

# ─── Application Settings ──────────────────────────────────────────────────
APP_ENV=development                # development | staging | production
APP_NAME=my-app
PORT=3000
HOST=0.0.0.0
DEBUG=true

# ─── Security & Authentication ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
APP_SECRET=your-secure-random-secret-key-min-32-chars
JWT_SECRET=your-secure-jwt-secret-key

# ─── Database ──────────────────────────────────────────────────────────────
# PostgreSQL / MySQL / SQLite connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/my_database?schema=public"

# ─── Cache & Message Broker (Optional) ────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Third-Party APIs (Optional) ──────────────────────────────────────────
API_KEY=""
CLIENT_ID=""
CLIENT_SECRET=""
